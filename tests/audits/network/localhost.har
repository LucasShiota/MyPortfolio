            "text": "import { CustomPhysicsEngine } from \"/src/components/features/physics/engines/CustomEngine.ts\";\nimport { LINKS } from \"/src/config/site.ts\";\nconst PHYSICS_CONFIG = {\n  // --- CORE SIMULATION ---\n  simulation: {\n    dt: 1 / 60,\n    // Target delta time\n    substeps: 4,\n    // Physics iterations for collision stability\n    frictionAir: 5e-3,\n    // Global air resistance (0 to 1)\n    restitution: 0.85,\n    // Bounciness (0 to 1)\n    forceScale: 2e3,\n    // Scaling factor for applied forces\n    massDensity: 1\n    // 1.0 = standard weight, higher = heavier bodies\n  },\n  // --- DRIFT BEHAVIOR ---\n  drift: {\n    force: 0.05,\n    // Subtle nudge force\n    maxAngleVariance: Math.PI / 4,\n    // Higher = more chaotic direction changes\n    updateFrequencyMs: 200\n    // How often to change nudge direction\n  },\n  // --- ROTATION ---\n  rotation: {\n    maxAngularVelocity: 0.5,\n    // Cap to prevent blurry spinning\n    airFriction: 0.98,\n    // How fast objects stop spinning (0 to 1)\n    impactFriction: 5e-3\n    // How much collision tangency affects rotation\n  },\n  // --- INTERACTION ---\n  interaction: {\n    grabBuffer: 0,\n    // Extra radius for easier grabbing\n    springStrength: 0.15,\n    // How \"tightly\" a grabbed body follows the mouse\n    hoverScale: 1.15,\n    // Scale multiplier on hover\n    hoverTransitionSpeed: 0.15\n    // Speed of the scale lerp\n  },\n  // --- BODIES ---\n  bodies: {\n    clickable: {\n      radius: 80,\n      hitboxMultiplier: 1.2,\n      category: 1\n    },\n    draggable: {\n      count: 5,\n      minRadius: 40,\n      maxRadius: 60,\n      category: 2\n    }\n  },\n  // --- VISUALS ---\n  colors: {\n    clickable: \"#0062F5\",\n    draggable: \"#F5A300\",\n    hoverGlow: \"#00A1F5\"\n  }\n};\nlet engine = null;\nlet animationFrameId = null;\nlet initVersion = 0;\nlet canvas = null;\nlet ctx = null;\nlet container = null;\nlet spriteSheet = null;\nlet a11yLayer = null;\nlet mouseP