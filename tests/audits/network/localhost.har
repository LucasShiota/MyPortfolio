          "content": {
            "size": 47798,
            "mimeType": "text/javascript",
            "text": "const CONFIG = {\n  motion: {\n    speed: 0.7,\n    reduceMotionSpeed: 0.15,\n    // Speed used when Reduced Motion is ON\n    reactToMouse: true,\n    mouseStrength: 0.5,\n    smoothColors: true\n    // Smoothly fade colors when changing themes\n  },\n  zoom: 0.8,\n  blurFactor: 0.9,\n  precision: \"mediump\",\n  seamlessTransition: false,\n  // If false, forces a visible \"jump\" when switching modes\n  performance: {\n    enabled: true,\n    // Toggle the entire multi-level system\n    override: \"auto\",\n    // \"auto\", \"high\", \"mid\", \"low\", \"off\" (0)\n    autoDowngrade: true,\n    // If FPS drops below threshold, drop a tier\n    autoUpgrade: false,\n    // If FPS is perfect for 5sec, try to move up\n    minFps: 45,\n    // Trigger for downgrade\n    sampleWindow: 120\n    // Frames to check before switching (approx 2sec)\n  }\n};\nconst PRESETS = {\n  high: [4, 1],\n  // 100% Crisp / 4 Layers (Capped at 4 for high-perf balanced with battery)\n  mid: [3, 0.75],\n  // 75% Scale / 3 Layers\n  low: [2, 0.5],\n  // 50% Scale / 2 Layers\n  eco: [1, 0.25],\n  // 25% Scale / 1 Layer (Ultra Low / Background mode)\n  off: [0, 0]\n  // Disabled\n};\nfunction initFog() {\n  const canvas = document.getElementById(\"fog-canvas\");\n  if (!canvas) return null;\n  const gl = canvas.getContext(\"webgl\");\n  if (!gl) return null;\n  let currentLevel = CONFIG.performance.override === \"auto\" ? window.innerWidth < 1024 ? \"low\" : \"high\" : CONFIG.performance.override;\n  let isFrozen = false;\n  let animationId;\n  let totalTime = 0;\n  let lastTime = performance.now();\n  let frameTimes = [];\n  let manualOverride = false;\n  let lastMoveTime = performance.now();\n  let isSleeping = false;\n  let previousLevel = currentLevel;\n  const TIME_WRAP = 6e4;\n  const SLEEP_DELAY = 5 * 60 * 1e3;\n  const setLevel = (lv, isManual = true) => {\n    if (!CONFIG.seamlessTransition && isManual && currentLevel !== lv && lv !== \"off\") {\n    }\n    manualOverride = isManual;\n    currentLevel = lv;\n    setupGPU(currentLevel);\n  };\n  const CACHE = {\n    w: window.innerWidth,\n    h: window.innerHeight,\n    isReducedMotion: false,\n    colors: {\n      base: [0, 0, 0],\n      low: [0, 0, 0],\n      mid: [0, 0, 0],\n      high: [0, 0, 0]\n    }\n  };\n  let isFirstFrame = true;\n  let currColors = {\n    base: [0, 0, 0],\n    low: [0, 0, 0],\n    mid: [0, 0, 0],\n    high: [0, 0, 0]\n  };\n  function lerpColorValue(curr, target, speed) {\n    curr[0] += (target[0] - curr[0]) * speed;\n    curr[1] += (target[1] - curr[1]) * speed;\n    curr[2] += (target[2] - curr[2]) * speed;\n  }\n  function hexToRgb(hex) {\n    hex = hex.trim().replace(\"#\", \"\");\n    if (hex.length === 3) hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];\n    const bigint = parseInt(hex, 16);\n    return [(bigint >> 16 & 255) / 255, (bigint >> 8 & 255) / 255, (bigint & 255) / 255];\n  }\n  function updateStateCache() {\n    const css = getComputedStyle(document.documentElement);\n    CACHE.isReducedMotion = css.getPropertyValue(\"--reduced-motion\") === \"true\" || document.documentElement.getAttribute(\"data-reduced-motion\") === \"true\";\n    CACHE.colors.base = hexToRgb(css.getPropertyValue(\"--vanta-base\") || \"#ffebcd\");\n    CACHE.colors.low = hexToRgb(css.getPropertyValue(\"--vanta-lowlight\") || \"#eebcff\");\n    CACHE.colors.mid = hexToRgb(css.getPropertyValue(\"--vanta-midtone\") || \"#ff9ee2\");\n    CACHE.colors.high = hexToRgb(css.getPropertyValue(\"--vanta-highlight\") || \"#ffd787\");\n  }\n  let resizeTimeout;\n  const onResize = () => {\n    if (resizeTimeout) cancelAnimationFrame(resizeTimeout);\n    resizeTimeout = requestAnimationFrame(() => {\n      CACHE.w = window.innerWidth;\n      CACHE.h = window.innerHeight;\n    });\n  };\n  window.addEventListener(\"resize\", onResize, { passive: true });\n  const observer = new MutationObserver(updateStateCache);\n  observer.observe(document.documentElement, {\n    attributes: true,\n    attributeFilter: [\"data-theme\", \"class\"]\n  });\n  updateStateCache();\n  const vsSource = `\n      attribute vec4 a_position;\n      void main() { gl_Position = a_position; }\n    `;\n  function getFsSource(octaves) {\n    return `\n        precision ${CONFIG.precision} float;\n        uniform vec2 u_resolution;\n        uniform float u_time;\n        uniform vec2 u_mouse;\n        uniform float u_mouseStrength;\n        uniform vec3 u_baseColor;\n        uniform vec3 u_lowlightColor;\n        uniform vec3 u_midtoneColor;\n        uniform vec3 u_highlightColor;\n        \n        float blurFactor = ${CONFIG.blurFactor.toFixed(2)};\n        float zoom = ${CONFIG.zoom.toFixed(2)};\n        \n        float random (in vec2 _st) {\n          return fract(sin(dot(_st.xy, vec2(0.129898,0.78233))) * 437.585453123);\n        }\n        \n        float noise (in vec2 _st) {\n          vec2 i = floor(_st);\n          vec2 f = fract(_st);\n          float a = random(i);\n          float b = random(i + vec2(1.0, 0.0));\n          float c = random(i + vec2(0.0, 1.0));\n          float d = random(i + vec2(1.0, 1.0));\n          vec2 u = f * f * (3.0 - 2.0 * f);\n          return mix(a, b, u.x) + (c - a)* u.y * (1.0 - u.x) + (d - b) * u.x * u.y;\n        }\n        \n        float fbm ( in vec2 _st) {\n          float v = 0.0;\n          float a = blurFactor;\n          vec2 shift = vec2(100.0);\n          mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.50));\n          for (int i = 0; i < ${octaves}; ++i) { // DYNAMIC OCTAVE COUNT\n              v += a * noise(_st);\n              _st = rot * _st * 2.0 + shift;\n              a *= (1. - blurFactor);\n          }\n          return v;\n        }\n        \n        void main() {\n          vec2 st = gl_FragCoord.xy / u_resolution.xy * 3.0;\n          st.x *= 0.7 * u_resolution.x / u_resolution.y; \n          st *= zoom;\n          vec3 color = vec3(0.0);\n          float t = u_time;\n          vec2 q = 