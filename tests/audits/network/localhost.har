            "mimeType": "text/javascript",
            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/src/components/features/performance/PerformanceToggle.astro?astro&type=style&index=0&lang.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"C:/Users/lshio/Desktop/Lucas Shiota/GitHub Repo/MyPortfolio/src/components/features/performance/PerformanceToggle.astro?astro&type=style&index=0&lang.css\"\nconst __vite__css = \"/*! tailwindcss v4.2.1 | MIT License | https://tailwindcss.com */\\n.performance-toggle {\\n  --pref-high: #e6a800;\\n  --pref-eco: #00cc6a;\\n  --pref-off: #888888;\\n  width: auto !important;\\n  height: 50px !important;\\n  padding: 0 16px !important;\\n  border-radius: 9999px !important;\\n  background: rgba(var(--gray),0.1) !important;\\n  border: none !important;\\n  transition: background var(--transition-fast) !important;\\n}\\nhtml[data-clarity=\\\"true\\\"] .performance-toggle {\\n  border: var(--border-width) solid var(--brand-secondary) !important;\\n  background: transparent !important;\\n}\\nhtml[data-clarity=\\\"true\\\"] .performance-toggle:hover {\\n  background: var(--brand-secondary) !important;\\n}\\nhtml[data-clarity=\\\"true\\\"] .performance-toggle:hover i.icon-perf,html[data-clarity=\\\"true\\\"] .performance-toggle:hover span.label-perf {\\n  color: var(--bg-base) !important;\\n}\\n.performance-toggle .toggle-content {\\n  display: flex !important;\\n  align-items: center !important;\\n  gap: 4px !important;\\n  pointer-events: none !important;\\n  height: 100% !important;\\n}\\n.performance-toggle .icon-stack {\\n  position: relative !important;\\n  width: 20px !important;\\n  height: 20px !important;\\n  display: flex !important;\\n  align-items: center !important;\\n  justify-content: center !important;\\n}\\n.performance-toggle i.icon-perf {\\n  position: absolute !important;\\n  font-size: 1.1rem !important;\\n  opacity: 0 !important;\\n  transform: translateY(10px) !important;\\n  transition: all 0.4s cubic-bezier(0.4,0,0.2,1) !important;\\n}\\n.performance-toggle .label-stack {\\n  position: relative !important;\\n  width: 36px !important;\\n  height: 20px !important;\\n  display: flex !important;\\n  align-items: center !important;\\n}\\n.performance-toggle span.label-perf {\\n  position: absolute !important;\\n  left: 0 !important;\\n  white-space: nowrap !important;\\n  text-transform: uppercase !important;\\n  font-weight: bold !important;\\n  font-size: 0.75rem !important;\\n  letter-spacing: 0.1em !important;\\n  opacity: 0 !important;\\n  transform: translateY(10px) !important;\\n  transition: all 0.4s cubic-bezier(0.4,0,0.2,1) !important;\\n  color: var(--text-color) !important;\\n}\\n.performance-toggle[data-mode=\\\"auto\\\"] {\\n  color: var(--pref-high) !important;\\n}\\n.performance-toggle[data-mode=\\\"auto\\\"] i.icon-auto,.performance-toggle[data-mode=\\\"auto\\\"] span.label-auto {\\n  opacity: 1 !important;\\n  transform: translateY(0) !important;\\n}\\n.performance-toggle[data-mode=\\\"eco\\\"] {\\n  color: var(--pref-eco) !important;\\n}\\n.performance-toggle[data-mode=\\\"eco\\\"] i.icon-eco,.performance-toggle[data-mode=\\\"eco\\\"] span.label-eco {\\n  opacity: 1 !important;\\n  transform: translateY(0) !important;\\n}\\n.performance-toggle[data-mode=\\\"off\\\"] {\\n  color: var(--pref-off) !important;\\n}\\n.performance-toggle[data-mode=\\\"off\\\"] i.icon-off,.performance-toggle[data-mode=\\\"off\\\"] span.label-off {\\n  opacity: 1 !important;\\n  transform: translateY(0) !important;\\n}\\n@media (hover: hover) {\\n  html:not([data-clarity=\\\"true\\\"]) .performance-toggle:hover {\\n    background: rgba(var(--gray),0.25) !important;\\n  }\\n}\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
