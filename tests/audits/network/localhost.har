          "content": {
            "size": 4003,
            "mimeType": "text/javascript",
            "text": "export const Vec2 = {\n  create: (x = 0, y = 0) => ({ x, y }),\n  add: (v1, v2) => ({\n    x: v1.x + v2.x,\n    y: v1.y + v2.y\n  }),\n  sub: (v1, v2) => ({\n    x: v1.x - v2.x,\n    y: v1.y - v2.y\n  }),\n  mul: (v, s) => ({\n    x: v.x * s,\n    y: v.y * s\n  }),\n  div: (v, s) => ({\n    x: v.x / s,\n    y: v.y / s\n  }),\n  dot: (v1, v2) => v1.x * v2.x + v1.y * v2.y,\n  magSq: (v) => v.x * v.x + v.y * v.y,\n  mag: (v) => Math.sqrt(v.x * v.x + v.y * v.y),\n  normalize: (v) => {\n    const m = Math.sqrt(v.x * v.x + v.y * v.y);\n    return m > 0 ? { x: v.x / m, y: v.y / m } : { x: 0, y: 0 };\n  },\n  distSq: (v1, v2) => {\n    const dx = v1.x - v2.x;\n    const dy = v1.y - v2.y;\n    return dx * dx + dy * dy;\n  },\n  dist: (v1, v2) => Math.sqrt(Vec2.distSq(v1, v2)),\n  copy: (v) => ({ x: v.x, y: v.y })\n};\n\n//# sourceMappingURL=data:application/json;base64,"
