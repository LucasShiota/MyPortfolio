            "text": "import { gsap } from \"/node_modules/.vite/deps/gsap.js?v=0c067080\";\nimport { ScrollTrigger } from \"/node_modules/.vite/deps/gsap_ScrollTrigger.js?v=0c067080\";\nimport { ScrollToPlugin } from \"/node_modules/.vite/deps/gsap_ScrollToPlugin.js?v=0c067080\";\ngsap.registerPlugin(ScrollTrigger, ScrollToPlugin);\nlet _panels = [];\nlet _totalSteps = 0;\nlet _step = 0;\nlet activeScrollTween = null;\nconst SIDEBAR_SCALE = { min: 1, max: 1.45, falloffRate: 1, falloffPower: 1.7 };\nconst refreshPanelConfig = () => {\n  _panels = gsap.utils.toArray(\".panel\");\n  _totalSteps = _panels.length - 1;\n  _step = _totalSteps > 0 ? 1 / _totalSteps : 1;\n};\nconst getCurrentPanelIndex = () => {\n  const scrollY = window.scrollY;\n  const maxScroll = document.body.scrollHeight - window.innerHeight;\n  const progressRatio = maxScroll > 0 ? scrollY / maxScroll : 0;\n  return Math.round(progressRatio / _step);\n};\nconst progressToScrollY = (progress) => {\n  const maxScroll = document.body.scrollHeight - window.innerHeight;\n  return progress * maxScroll;\n};\nconst scrollToIndex = (index) => {\n  if (_totalSteps <= 0) return;\n  const clamped = gsap.utils.clamp(0, _totalSteps, index);\n  const targetY = progressToScrollY(clamped * _step);\n  const isReducedMotion = document.documentElement.getAttribute(\"data-reduced-motion\") === \"true\";\n  activeScrollTween?.kill();\n  activeScrollTween = gsap.to(window, {\n    duration: isReducedMotion ? 0 : 0.7,\n    scrollTo: { y: targetY },\n    ease: \"power2.inOut\"\n  });\n};\nconst initScrollNavigation = () => {\n  const navSections = document.querySelectorAll(\".nav-section\");\n  navSections.forEach((section, index) => {\n    section.addEventListener(\"click\", () => {\n      scrollToIndex(index);\n    });\n    section.setAttribute(\"tabindex\", \"0\");\n    section.addEventListener(\"keydown\", (e) => {\n      if (e.key === \"Enter\" || e.key === \" \") {\n        e.preventDefault();\n        scrollToIndex(inde