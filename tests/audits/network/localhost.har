            "mimeType": "text/javascript",
            "text": "let isMarqueeInitialized = false;\nlet marqueeApplyThrottle = () => {\n};\nconst startMarquee = () => {\n  if (isMarqueeInitialized) return;\n  isMarqueeInitialized = true;\n  const marquees = document.querySelectorAll(\".marquee\");\n  const cleanups = [];\n  const heroPanel = document.querySelector(\".hero-panel\");\n  let isHeroVisible = true;\n  const applyMarqueeThrottle = () => {\n    const shouldPause = document.hidden || !isHeroVisible || Boolean(window.__performanceModeEnabled);\n    marquees.forEach((marquee) => {\n      marquee.classList.toggle(\"marquee--paused\", shouldPause);\n    });\n  };\n  marqueeApplyThrottle = applyMarqueeThrottle;\n  const setupMarquee = (marquee) => {\n    const track = marquee.querySelector(\".marquee-track\");\n    const baseContent = marquee.querySelector(\".marquee-content\");\n    if (!track || !baseContent) return;\n    const direction = marquee.getAttribute(\"data-direction\") || \"left\";\n    const customSpeed = parseFloat(marquee.getAttribute(\"data-speed\") || \"2\");\n    const rebuildTrack = () => {\n      const allSegments = track.querySelectorAll(\".marquee-content\");\n      allSegments.forEach((segment, index) => {\n        if (index > 0) segment.remove();\n      });\n      const segmentWidth = baseContent.getBoundingClientRect().width;\n      if (segmentWidth <= 0) return;\n      const viewportWidth = marquee.clientWidth || window.innerWidth;\n      const segmentsNeeded = Math.max(\n        3,\n        Math.ceil((viewportWidth + segmentWidth) / segmentWidth) + 1\n      );\n      for (let i = 1; i < segmentsNeeded; i++) {\n        const clone = baseContent.cloneNode(true);\n        track.appendChild(clone);\n      }\n      const pxPerSecond = Math.max(12, customSpeed * 60);\n      const duration = segmentWidth / pxPerSecond;\n      marquee.style.setProperty(\"--marquee-distance\", `${segmentWidth}px`);\n      marquee.style.setProperty(\"--marquee-duration\", `${duration.toFixed(2)}s`);\n      marquee.classList.toggle(\"marquee--right\", direction === \"right\");\n      marquee.classList.add(\"marquee--ready\");\n    };\n    rebuildTrack();\n    const resizeObserver = new ResizeObserver(rebuildTrack);\n    resizeObserver.observe(marquee);\n    resizeObserver.observe(baseContent);\n    cleanups.push(() => resizeObserver.disconnect());\n  };\n  marquees.forEach(setupMarquee);\n  const onVisibilityChange = () => {\n    applyMarqueeThrottle();\n  };\n  document.addEventListener(\"visibilitychange\", onVisibilityChange);\n  cleanups.push(() => {\n    document.removeEventListener(\"visibilitychange\", onVisibilityChange);\n  });\n  if (heroPanel) {\n    const heroObserver = new IntersectionObserver(\n      (entries) => {\n        isHeroVisible = entries.some((entry) => entry.isIntersecting);\n        applyMarqueeThrottle();\n      },\n      { threshold: 0.1 }\n    );\n    heroObserver.observe(heroPanel);\n    cleanups.push(() => heroObserver.disconnect());\n  }\n  applyMarqueeThrottle();\n  window.addEventListener(\n    \"beforeunload\",\n    () => {\n      cleanups.forEach((fn) => fn());\n    },\n    { once: true }\n  );\n};\nconst bootstrapIfMissedStartup = () => {\n  startMarquee();\n};\nwindow.performanceModeMarquee = {\n  start: startMarquee,\n  refresh: () => {\n    if (!isMarqueeInitialized) {\n      startMarquee();\n    }\n    marqueeApplyThrottle();\n  }\n};\nwindow.addEventListener(\"startup:marquee\", startMarquee);\nif (document.readyState === \"loading\") {\n  document.addEventListener(\"DOMContentLoaded\", bootstrapIfMissedStartup, { once: true });\n} else {\n  bootstrapIfMissedStartup();\n}\n\n//# sourceMappingURL=data:application/json;base64,"
