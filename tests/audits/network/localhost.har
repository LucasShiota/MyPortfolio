          "content": {
            "size": 10974,
            "mimeType": "text/javascript",
            "text": "function setupPopups() {\n  const wrappers = document.querySelectorAll(\".popup-wrapper\");\n  wrappers.forEach((wrapper) => {\n    const triggerContainer = wrapper.querySelector(\".popup-trigger\");\n    const btn = triggerContainer?.firstElementChild;\n    if (!btn) return;\n    const updateAria = (expanded) => {\n      btn.setAttribute(\"aria-expanded\", expanded.toString());\n    };\n    btn.addEventListener(\"click\", (e) => {\n      e.stopPropagation();\n      const isPinned = wrapper.classList.contains(\"active\");\n      document.querySelectorAll(\".popup-wrapper\").forEach((w) => {\n        if (w !== wrapper) {\n          w.classList.remove(\"active\");\n          w.querySelector(\".popup-trigger\")?.firstElementChild?.setAttribute(\n            \"aria-expanded\",\n            \"false\"\n          );\n        }\n      });\n      wrapper.classList.toggle(\"active\");\n      updateAria(!isPinned);\n    });\n    const panel = wrapper.querySelector(\".popup-panel\");\n    panel?.addEventListener(\"click\", (e) => {\n      e.stopPropagation();\n    });\n    wrapper.addEventListener(\"mouseenter\", () => {\n      updateAria(true);\n    });\n    wrapper.addEventListener(\"mouseleave\", () => {\n      if (!wrapper.classList.contains(\"active\")) {\n        updateAria(false);\n      }\n    });\n  });\n  document.addEventListener(\"click\", () => {\n    document.querySelectorAll(\".popup-wrapper\").forEach((w) => {\n      w.classList.remove(\"active\");\n      w.querySelector(\".popup-trigger\")?.firstElementChild?.setAttribute(\n        \"aria-expanded\",\n        \"false\"\n      );\n    });\n  });\n}\nsetupPopups();\ndocument.addEventListener(\"astro:after-swap\", setupPopups);\n\n//# sourceMappingURL=data:application/json;base64,"
          },
          "redirectURL": "",
          "headersSize": 179,
          "bodySize": 0,
