            "mimeType": "text/javascript",
            "text": "function initAboutTabs() {\n  const buttons = document.querySelectorAll(\".about-tab-btn\");\n  const contents = document.querySelectorAll(\".tab-content\");\n  if (!buttons.length) return;\n  buttons.forEach((btn) => {\n    btn.addEventListener(\"click\", (e) => {\n      const targetId = e.currentTarget.dataset.tabTarget;\n      buttons.forEach((b) => {\n        b.classList.remove(\n          \"border-(--brand-secondary)\",\n          \"txt-color-accent\",\n          \"opacity-100\",\n          \"is-active\"\n        );\n        b.classList.add(\"border-transparent\", \"opacity-40\");\n      });\n      contents.forEach((c) => {\n        c.classList.remove(\"opacity-100\", \"pointer-events-auto\", \"z-10\");\n        c.classList.add(\"opacity-0\", \"pointer-events-none\", \"z-0\");\n      });\n      e.currentTarget.classList.remove(\n        \"border-transparent\",\n        \"opacity-40\"\n      );\n      e.currentTarget.classList.add(\n        \"border-(--brand-secondary)\",\n        \"txt-color-accent\",\n        \"opacity-100\",\n        \"is-active\"\n      );\n      const targetContent = document.getElementById(`tab-content-${targetId}`);\n      if (targetContent) {\n        targetContent.classList.remove(\"opacity-0\", \"pointer-events-none\", \"z-0\");\n        targetContent.classList.add(\"opacity-100\", \"pointer-events-auto\", \"z-10\");\n      }\n    });\n  });\n}\ndocument.addEventListener(\"astro:page-load\", initAboutTabs);\nif (document.readyState === \"complete\") {\n  initAboutTabs();\n} else {\n  document.addEventListener(\"DOMContentLoaded\", initAboutTabs);\n}\n\n//# sourceMappingURL=data:application/json;base64,"
