, 1.5rem);\\n  line-height: var(--tw-leading, var(--text-2xl--line-height, calc(2 / 1.5)));\\n  transition: opacity 0.4s cubic-bezier(0.4,0,0.2,1),transform 0.4s cubic-bezier(0.4,0,0.2,1),color var(--transition-fast) ease;\\n  opacity: 1;\\n  transform: scale(var(--icon-scale, 1)) rotate(0deg);\\n}\\n.header-icon-btn i.hidden-icon {\\n  opacity: 0;\\n  pointer-events: none;\\n  transform: scale(0.6) rotate(-45deg);\\n}\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
