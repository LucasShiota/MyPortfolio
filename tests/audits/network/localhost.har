            "text": "function setupLetsTalkCopy() {\n  const copyBtns = document.querySelectorAll(\".lets-talk-wrapper .copy-btn\");\n  copyBtns.forEach((btn) => {\n    const newBtn = btn.cloneNode(true);\n    btn.parentNode?.replaceChild(newBtn, btn);\n    newBtn.addEventListener(\"click\", async (e) => {\n      e.preventDefault();\n      const text = newBtn.getAttribute(\"data-copy\");\n      if (text) {\n        try {\n          await navigator.clipboard.writeText(text);\n          newBtn.classList.add(\"copied\");\n          const textSpan = newBtn.querySelector(\".btn-text\");\n          const originalText = textSpan ? textSpan.textContent : \"\";\n          if (textSpan) textSpan.textContent = \"Copied!\";\n          setTimeout(() => {\n            newBtn.classList.remove(\"copied\");\n            if (textSpan) textSpan.textContent = originalText;\n          }, 2e3);\n        } catch (err) {\n          console.error(\"Failed to copy\", err);\n        }\n      }\n    });\n  });\n}\nsetupLetsTalkCopy();\ndocument.addEventListener(\"astro:after-swap\", setupLetsTalkCopy);\n\n//# sourceMappingURL=data:application/json;base64,"
          },
