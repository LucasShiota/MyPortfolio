---
/**
 * ══════════════════════════════════════════════
 *  CONTACTS PANEL
 * ══════════════════════════════════════════════
 *
 * PURPOSE: Interactive canvas with floating physics-based social links.
 */
---

<section id="contacts" class="panel contacts-panel flx-cntr">
  <div id="matter-container" class="surface-panel"></div>
</section>

<style>
  @reference "../../../styles/global.css";

  .contacts-panel {
    /* Layout is handled by global .panel class */
    padding-bottom: 2rem;
  }
  #matter-container {
    position: relative;
    width: 95%;
    height: 88%;
    max-width: 1400px;
    z-index: 1;
    overflow: hidden;
    @apply animate-fade-in;
  }
  .copyright {
    position: absolute;
    bottom: 1%;
    right: -15%;
    @apply txt-body;
    pointer-events: none;
    opacity: 0.8;
  }
</style>

<script>
  import { initMatterController } from "../../features/matterjs/matterController";

  initMatterController();
</script>
