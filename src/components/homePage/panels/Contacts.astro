---
/**
 * ══════════════════════════════════════════════
 *  CONTACTS PANEL
 * ══════════════════════════════════════════════
 *
 * PURPOSE: Interactive canvas with floating physics-based social links.
 */
---

<section id="contacts" class="panel contacts-panel">
  <div id="matter-container"></div>
</section>

<style>
  @reference "../../../styles/global.css";

  .contacts-panel {
    /* Layout is handled by global .panel class */
  }
  #matter-container {
    position: relative;
    width: 100%;
    height: 100%;
    flex: 1; /* Take all available space in the flex panel */
    touch-action: auto;
    z-index: 1;
    overflow: hidden;
  }
  .copyright {
    position: absolute;
    bottom: 1%;
    right: -15%;
    @apply txt-body;
    pointer-events: none;
    opacity: 0.8;
  }
</style>

<script>
  import { initMatterController } from "../../features/matterjs/matterController";

  initMatterController();
</script>
